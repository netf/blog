---
import PostList from '../../components/PostList.astro';
import Base from '../../layouts/Base.astro';
import { getPosts, type Post } from '../../lib/posts';

const posts = await getPosts();
const byYear = new Map<number, Post[]>();
for (const post of posts) {
	const year = post.data.pubDate.getUTCFullYear();
	byYear.set(year, [...(byYear.get(year) ?? []), post]);
}
---

<Base title="Posts" description="Every post, newest first.">
	<section class="container page-head">
		<p class="eyebrow">ls -lt ./posts</p>
		<h1>Posts</h1>
		<p>{posts.length} {posts.length === 1 ? 'entry' : 'entries'} on DevOps and platform engineering.</p>
	</section>
	<section class="container">
		{
			[...byYear].map(([year, yearPosts]) => (
				<div class="year">
					<h2>{year}</h2>
					<PostList posts={yearPosts} />
				</div>
			))
		}
	</section>
</Base>

<style>
	.year + .year {
		margin-top: 3rem;
	}
	h2 {
		margin: 0 0 0.75rem;
		font-family: var(--font-mono);
		font-size: 0.85rem;
		font-weight: 500;
		color: var(--subtle);
		letter-spacing: 0;
	}
</style>

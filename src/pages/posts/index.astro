---
import PageHead from '../../components/PageHead.astro';
import PostTiles from '../../components/PostTiles.astro';
import Base from '../../layouts/Base.astro';
import { getPosts, type Post } from '../../lib/posts';

const posts = await getPosts();
const byYear = new Map<number, Post[]>();
for (const post of posts) {
	const year = post.data.pubDate.getUTCFullYear();
	byYear.set(year, [...(byYear.get(year) ?? []), post]);
}
---

<Base title="Archive" description="Every post, newest first.">
	<div class="container">
		<PageHead eyebrow="Archive" title="Every post, newest first" seed="archive">
			<p>{posts.length} {posts.length === 1 ? 'post' : 'posts'} on platform, data and AI.</p>
		</PageHead>
		{
			[...byYear].map(([year, yearPosts]) => (
				<section class="year" aria-labelledby={`y${year}`}>
					<h2 id={`y${year}`} class="eyebrow">
						{year}
					</h2>
					<PostTiles posts={yearPosts} />
				</section>
			))
		}
	</div>
</Base>

<style>
	.year + .year {
		margin-top: var(--space-16);
	}
	h2 {
		margin-bottom: var(--space-6);
		padding-bottom: var(--space-3);
		border-bottom: var(--stroke) solid var(--line);
		color: var(--ink-muted);
	}
</style>

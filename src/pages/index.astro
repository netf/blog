---
import FormattedDate from '../components/FormattedDate.astro';
import IsoArt from '../components/IsoArt.astro';
import PostTiles from '../components/PostTiles.astro';
import TopicMenu from '../components/TopicMenu.astro';
import { url } from '../consts';
import Base from '../layouts/Base.astro';
import { getFeatured, getPosts, getTags, PILLARS, readingTime, wordCount } from '../lib/posts';

const posts = await getPosts();
const featured = getFeatured(posts);
const rest = posts.filter((p) => p !== featured).slice(0, 6);
const tags = [...getTags(posts)];
const words = posts.reduce((n, p) => n + wordCount(p.body), 0);
const first = posts.at(-1)?.data.pubDate;
const fmt = (n: number) => (n >= 1000 ? `${(n / 1000).toFixed(1)}K` : String(n));
---

<Base>
	<div class="container home">
		<section class="panel intro">
			<!-- One drawing spans both top panels; each panel shows its slice, colours flipped. -->
			<div class="span-art"><IsoArt seed="netf-field-notes" cols={13} rows={9} height={5} instance="a" /></div>
			<div class="intro-copy">
				<p class="eyebrow kicker"><span>01 / Platform</span> <span>02 / Data</span> <span>03 / AI</span></p>
				<h1>Notes from the blast radius</h1>
				<p class="lead">
					I spend my days making production boring and my nights finding out it wasn't. These are the
					notes.
				</p>
				<dl class="stats">
					<div>
						<dt>Posts</dt>
						<dd>{posts.length}</dd>
					</div>
					<div>
						<dt>Topics</dt>
						<dd>{tags.length}</dd>
					</div>
					<div>
						<dt>Words</dt>
						<dd>{fmt(words)}</dd>
					</div>
					{
						first && (
							<div>
								<dt>Since</dt>
								<dd>
									<FormattedDate date={first} />
								</dd>
							</div>
						)
					}
				</dl>
				<a class="cta" href={url('/posts')}>Explore the archive</a>
			</div>
		</section>

		{
			featured && (
				<section class="panel inverse latest" aria-labelledby="latest-title">
					<div class="span-art">
						<IsoArt seed="netf-field-notes" cols={13} rows={9} height={5} instance="b" />
					</div>
					<div class="latest-copy">
						<p class="eyebrow latest-kicker">
							<span>Latest</span>
							<span>
								{PILLARS[featured.data.pillar].index} / {PILLARS[featured.data.pillar].label}
							</span>
						</p>
						<h2 id="latest-title">
							<a href={url(`/posts/${featured.id}/`)}>{featured.data.title}</a>
						</h2>
						<p class="latest-dek">{featured.data.description}</p>
						<p class="meta">
							<FormattedDate date={featured.data.pubDate} /> &nbsp; {readingTime(featured.body)} &nbsp;{' '}
							{featured.data.tags.join(' · ')}
						</p>
						<a class="cta" href={url(`/posts/${featured.id}/`)}>
							Read the post
						</a>
					</div>
				</section>
			)
		}

		{
			rest.length > 0 && (
				<section class="more" aria-labelledby="more">
					<div class="section-head">
						<h2 id="more" class="eyebrow">
							More writing
						</h2>
						<a class="btn btn-ghost" href={url('/posts')}>
							Archive &rarr;
						</a>
					</div>
					<PostTiles posts={rest} />
				</section>
			)
		}

		{
			tags.length > 0 && (
				<section class="panel topics" aria-labelledby="topics">
					<h2 id="topics" class="eyebrow topics-head">
						Topics
					</h2>
					<TopicMenu tags={tags} />
				</section>
			)
		}
	</div>
</Base>

<style>
	/* Desktop bento: intro and latest side by side, tiles, then the topics menu.
	   The grid is a size container so the shared drawing can be as wide as the row (100cqi). */
	.home {
		--art-h: 400px;
		container-type: inline-size;
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		gap: var(--space-6);
		padding-top: var(--space-8);
	}
	.intro {
		grid-column: span 7;
		display: flex;
		flex-direction: column;
		padding-top: var(--art-h);
	}
	.latest {
		grid-column: span 5;
		display: flex;
		flex-direction: column;
		padding-top: var(--art-h);
	}
	.more,
	.topics {
		grid-column: 1 / -1;
	}

	/* The shared drawing: row-wide, pinned to the row's left edge in the intro and its right
	   edge in latest, so the two slices line up across the gap. -1px offsets the panel border. */
	.span-art {
		position: absolute;
		top: 0;
		width: 100cqi;
		height: var(--art-h);
	}
	.intro .span-art {
		left: -1px;
	}
	.latest .span-art {
		right: -1px;
	}
	.intro-copy {
		padding: var(--space-6) var(--space-8) var(--space-8);
	}
	.kicker {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1) var(--space-6);
		margin: 0;
		color: var(--ink-muted);
	}
	.kicker span {
		white-space: nowrap;
	}
	h1 {
		max-width: 18ch;
		margin-top: var(--space-4);
		font-size: 56px;
		line-height: 60px;
		letter-spacing: -0.03em;
	}
	.lead {
		max-width: 36rem;
		margin: var(--space-4) 0 0;
		font-size: 20px;
		line-height: 32px;
		color: var(--ink-secondary);
	}
	.stats {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4) var(--space-12);
		margin: var(--space-8) 0;
		padding-top: var(--space-6);
		border-top: var(--stroke) solid var(--line);
	}
	.stats dt {
		font-family: var(--font-mono);
		font-size: 13px;
		line-height: 20px;
		color: var(--ink-muted);
	}
	.stats dd {
		margin: var(--space-1) 0 0;
		font-size: 28px;
		line-height: 36px;
		font-weight: 600;
		letter-spacing: -0.02em;
		font-variant-numeric: tabular-nums;
	}

	/* Latest: the solid panel; its copy sits at the bottom, level with the intro's. */
	.latest-copy {
		margin-top: auto;
		padding: var(--space-6) var(--space-8) var(--space-8);
	}
	.latest-kicker {
		display: flex;
		justify-content: space-between;
		gap: var(--space-4);
		margin: 0;
		color: var(--ink-muted);
	}
	.latest h2 {
		margin-top: var(--space-4);
		font-size: 28px;
		line-height: 36px;
		letter-spacing: -0.02em;
	}
	.latest h2 a {
		text-decoration: none;
	}
	.latest-dek {
		margin: var(--space-3) 0 0;
		font-size: 15px;
		line-height: 24px;
		color: var(--ink-secondary);
	}
	.latest .meta {
		margin: var(--space-4) 0 var(--space-8);
	}

	/* More writing */
	.more {
		margin-top: var(--space-12);
	}
	.section-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		margin-bottom: var(--space-6);
		padding-bottom: var(--space-3);
		border-bottom: var(--stroke) solid var(--line);
	}
	.section-head h2 {
		color: var(--ink-muted);
	}

	/* Topics as a big menu, two columns of large type. */
	.topics {
		margin-top: var(--space-12);
		padding: var(--space-8);
	}
	.topics-head {
		margin-bottom: var(--space-6);
		color: var(--ink-muted);
	}
	/* Stacked: the intro keeps the whole drawing; latest turns typographic. */
	@media (max-width: 1080px) {
		.home {
			--art-h: 300px;
		}
		.intro,
		.latest {
			grid-column: 1 / -1;
		}
		.latest {
			padding-top: 0;
		}
		.latest .span-art {
			display: none;
		}
	}
	@media (max-width: 640px) {
		.home {
			--art-h: 220px;
			gap: var(--space-4);
			padding-top: var(--space-4);
		}
		.intro-copy {
			padding: var(--space-6);
		}
		h1 {
			font-size: 40px;
			line-height: 46px;
			letter-spacing: -0.025em;
		}
		.stats {
			gap: var(--space-4) var(--space-8);
		}
		.latest-copy {
			padding: var(--space-6);
		}
		.topics {
			padding: var(--space-6);
		}
	}
</style>

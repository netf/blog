---
import { url } from '../consts';
import Base from '../layouts/Base.astro';
---

<Base title="404" description="Page not found.">
	<section class="container page-head">
		<p class="eyebrow">exit code 404</p>
		<h1>Not found</h1>
		<pre><code>Error from server (NotFound): pages "{Astro.url.pathname}" not found</code></pre>
		<p><a href={url('/')}>&larr; back home</a></p>
	</section>
</Base>

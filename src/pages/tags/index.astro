---
import PageHead from '../../components/PageHead.astro';
import TopicMenu from '../../components/TopicMenu.astro';
import Base from '../../layouts/Base.astro';
import { getPosts, getTags } from '../../lib/posts';

const tags = [...getTags(await getPosts())];
---

<Base title="Topics" description="Browse posts by topic.">
	<div class="container">
		<PageHead eyebrow="Topics" title="Browse by topic" seed="topics" inverse>
			<p>Every topic covered so far, most written-about first.</p>
		</PageHead>
		<TopicMenu tags={tags} />
	</div>
</Base>

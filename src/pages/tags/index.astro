---
import Tag from '../../components/Tag.astro';
import Base from '../../layouts/Base.astro';
import { getPosts, getTags } from '../../lib/posts';

const tags = getTags(await getPosts());
---

<Base title="Tags" description="Browse posts by topic.">
	<section class="container page-head">
		<p class="eyebrow">grep -r --tags</p>
		<h1>Tags</h1>
		<p>Browse posts by topic.</p>
	</section>
	<section class="container tags">
		{[...tags].map(([tag, count]) => <Tag tag={tag} count={count} />)}
	</section>
</Base>

<style>
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
	}
</style>

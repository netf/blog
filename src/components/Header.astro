---
import { url } from '../consts';
import Icon from './Icon.astro';

const links = [
	{ href: '/posts', label: 'Archive' },
	{ href: '/tags', label: 'Topics' },
	{ href: '/about', label: 'About' },
];

const current = Astro.url.pathname.replace(/\/$/, '');
const isActive = (href: string) => current === url(href) || current.startsWith(`${url(href)}/`);
---

<div class="sticky" data-header>
	<header class="site-header container">
		<a class="wordmark" href={url('/')} aria-label="netf, home">
			netf<span class="cursor" aria-hidden="true"></span>
		</a>
		<nav aria-label="Main">
			{
				links.map(({ href, label }) => (
					<a href={url(href)} aria-current={isActive(href) ? 'page' : undefined}>
						{label}
					</a>
				))
			}
		</nav>
		<button class="btn btn-ghost search" type="button" data-search-open aria-label="Search posts" aria-keyshortcuts="Meta+K Control+K /">
			<Icon name="search" size={16} />
			<span class="label">Search</span>
			<kbd class="shortcut">⌘K</kbd>
		</button>
	</header>
</div>

<script>
	// Show the shortcut the visitor's platform actually uses.
	if (!/Mac|iPhone|iPad/.test(navigator.platform)) {
		const kbd = document.querySelector('.site-header .shortcut');
		if (kbd) kbd.textContent = 'Ctrl K';
	}

	// The header slides away while you scroll down, and comes back when you scroll up,
	// stop scrolling, reach the top, or move keyboard focus into it.
	const bar = document.querySelector<HTMLElement>('[data-header]');
	if (bar) {
		let lastY = scrollY;
		let idle: number | undefined;
		const show = () => bar.classList.remove('is-hidden');
		addEventListener(
			'scroll',
			() => {
				const y = scrollY;
				if (y < bar.offsetHeight * 2 || y < lastY - 4) show();
				else if (y > lastY + 4 && !bar.contains(document.activeElement)) bar.classList.add('is-hidden');
				lastY = y;
				clearTimeout(idle);
				idle = window.setTimeout(show, 700);
			},
			{ passive: true },
		);
		bar.addEventListener('focusin', show);
	}
</script>

<style>
	.sticky {
		position: sticky;
		top: 0;
		z-index: 20;
		background: var(--bg-raised);
		border-bottom: var(--stroke) solid var(--line);
		transition: transform 200ms ease-out;
	}
	.sticky:global(.is-hidden) {
		transform: translateY(-100%);
	}
	@media (prefers-reduced-motion: reduce) {
		.sticky {
			transition: none;
		}
	}
	.site-header {
		display: flex;
		align-items: center;
		gap: var(--space-8);
		height: var(--header-height);
	}
	/* The wordmark is type: Plex Mono 600 plus a solid ink block cursor. Not animated. */
	.wordmark {
		display: inline-flex;
		align-items: center;
		gap: 2px;
		font-family: var(--font-mono);
		font-size: 16px;
		font-weight: 600;
		letter-spacing: -0.02em;
		color: var(--ink);
		text-decoration: none;
	}
	.cursor {
		display: inline-block;
		width: 9px;
		height: 18px;
		margin-left: 2px;
		background: var(--ink);
	}
	nav {
		display: flex;
		flex: 1;
		gap: var(--space-1);
		min-width: 0;
	}
	nav a {
		padding: var(--space-2) var(--space-3);
		border-radius: var(--radius-sm);
		font-family: var(--font-mono);
		font-size: 12px;
		line-height: 16px;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		white-space: nowrap;
		color: var(--ink-secondary);
		text-decoration: none;
		transition:
			color var(--ease),
			background-color var(--ease);
	}
	nav a:hover {
		color: var(--ink);
		background: var(--bg-sunken);
	}
	nav a[aria-current='page'] {
		color: var(--ink);
		border-radius: 0;
		box-shadow: inset 0 -1px 0 var(--ink);
	}
	.search {
		margin-right: calc(-1 * var(--space-2));
	}
	.shortcut {
		margin-left: var(--space-1);
		letter-spacing: 0;
		text-transform: none;
	}
	@media (max-width: 640px) {
		.search .label,
		.search .shortcut {
			display: none;
		}
		.site-header {
			gap: var(--space-3);
		}
		nav a {
			padding-inline: var(--space-2);
		}
	}
</style>

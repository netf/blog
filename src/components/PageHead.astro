---
import IsoArt from './IsoArt.astro';

interface Props {
	/** Mono kicker above the title. */
	eyebrow: string;
	title: string;
	/** Seeds the art, so each page keeps its own drawing. */
	seed: string;
	/** Use the solid inverse panel. */
	inverse?: boolean;
}

const { eyebrow, title, seed, inverse = false } = Astro.props;
---

<header class="panel page-panel" class:list={{ inverse }}>
	<div class="copy">
		<p class="eyebrow kicker">{eyebrow}</p>
		<h1>{title}</h1>
		<div class="sub"><slot /></div>
	</div>
	<div class="art"><IsoArt seed={seed} cols={5} rows={4} height={4} /></div>
</header>

<style>
	.page-panel {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
		height: 340px;
		margin-block: var(--space-8) var(--space-12);
	}
	.copy {
		align-self: end;
		padding: var(--space-8);
	}
	.kicker {
		margin: 0;
		color: var(--ink-muted);
	}
	h1 {
		margin-top: var(--space-3);
		font-size: 40px;
		line-height: 46px;
		letter-spacing: -0.025em;
		overflow-wrap: anywhere;
	}
	.sub {
		max-width: 36rem;
		margin-top: var(--space-3);
		color: var(--ink-secondary);
	}
	.sub :global(p) {
		margin: 0;
	}
	/* The art bleeds off the top and right edges. */
	.art {
		min-height: 0;
		margin: calc(-1 * var(--space-8)) calc(-1 * var(--space-8)) 0 0;
	}
	@media (max-width: 760px) {
		.page-panel {
			height: auto;
			grid-template-columns: 1fr;
			margin-block: var(--space-4) var(--space-8);
		}
		.art {
			grid-row: 1;
			height: 200px;
			margin: calc(-1 * var(--space-6)) calc(-1 * var(--space-6)) 0 0;
		}
		.copy {
			padding: 0 var(--space-6) var(--space-6);
		}
		h1 {
			font-size: 32px;
			line-height: 40px;
		}
	}
</style>

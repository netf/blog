# Cache headers for Cloudflare Workers static assets.

# Fingerprinted build output (CSS, JS, fonts): the filename changes when the content does.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Social cards are rebuilt on deploy, so cache them for a day.
/og/*
  Cache-Control: public, max-age=86400

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

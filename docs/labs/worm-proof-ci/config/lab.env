# Shared constants for the worm-proof-ci lab. Sourced by every script.
# Network layout: a veth pair connects the host (root) netns to a per-run jail netns.
# The registry and the canary sinks live on the host side; the install runs in the jail.
export LAB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export NETNS=wormlab
export VETH_HOST=veth-wh
export VETH_NS=veth-wn
export HOST_IP=10.188.0.1
export NS_IP=10.188.0.2

export REGISTRY_PORT=4873
export REGISTRY_URL="http://${HOST_IP}:${REGISTRY_PORT}"

# Canary exfiltration sinks (host side). "Theft" means a canary value arriving here.
export HTTP_SINK_PORT=9099
export DNS_SINK_PORT=5300

# Fake canary values. These are the ONLY secrets in the lab. They are not real credentials.
export CANARY_NPM="CANARY-NPM-7f3a9c2e5b1d4068"
export CANARY_GH="CANARY-GH-0b5e8d1a6c9f2374"
export CANARY_AWS="CANARY-AWS-4d2f7a0e9b3c6185"
# A secret committed into the repository itself (a checked-in .env), used by the workspace test.
export CANARY_REPO="CANARY-REPO-91c04e7d2a6b3f58"

# Publish-stage account for the LOCAL registry (only the publish stage ever sees it).
export PUBLISH_USER=release-bot
export PUBLISH_PASS=release-bot-pw
